#!/usr/bin/env bash
set -euo pipefail
[[ $# == 1 ]] || { echo 'usage: scripts/check-sdk PREFIX' >&2; exit 1; }
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
prefix=$(cd -- "$1" && pwd)
export PKG_CONFIG_PATH="$prefix/lib/pkgconfig"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
read -ra flags <<< "$(pkg-config --cflags --libs kiln)"
case "$(uname -s)" in
  Linux) compiler=musl-gcc; flags+=(-static) ;;
  Darwin) compiler=cc ;;
  *) echo 'unsupported host' >&2; exit 1 ;;
esac
"$compiler" -std=c11 -Wall -Wextra -Werror "$root/test/ffi.c" "${flags[@]}" -o "$stage/ffi"
"$stage/ffi"
