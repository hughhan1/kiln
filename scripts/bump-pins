#!/usr/bin/env bash
# Refresh providers/pins.ml from upstream. Planning itself never touches the
# network; this script is the only place Kiln looks anything up.
set -euo pipefail
cd "$(dirname "$0")/.."
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT

die() {
  echo "bump-pins: $*" >&2
  exit 1
}

fetch() { curl --fail --silent --show-error --location "$@"; }

registry() {
  local token
  token=$(fetch "https://auth.docker.io/token?service=registry.docker.io&scope=repository:$1:pull" | jq -er .token)
  fetch -H "Authorization: Bearer $token" \
    -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/json' \
    "https://registry-1.docker.io/v2/$1/$2"
}

# The digest-pinned reference of a tag that every Kiln target can pull. A tag
# without both platforms returns 2, and its release is left out.
image() {
  registry "$1" "manifests/$2" > "$stage/index" || die "cannot fetch $1:$2"
  if ! jq -e '[.manifests[].platform | .os + "/" + .architecture] | contains(["linux/amd64", "linux/arm64"])' \
    "$stage/index" > /dev/null; then
    echo "bump-pins: skipping $1:$2, which lacks linux/amd64 or linux/arm64" >&2
    return 2
  fi
  echo "docker.io/$1@sha256:$(sha256sum "$stage/index" | cut -d' ' -f1)"
}

# Reads tags. Prints the newest patch of the $1 newest minor releases, oldest first.
newest_minors() {
  jq -Rrn --argjson count "$1" '
    [inputs | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) | split(".") | map(tonumber)]
    | group_by(.[:2]) | map(max) | .[-$count:][] | map(tostring) | join(".")'
}

# Reads tags. Prints each stable release, oldest first, with whether to refresh
# it: every patch of a minor from $1 on and the newest patch of an older one,
# refreshing only the newest patch of the $2 newest minors.
patches() {
  jq -Rrn --argjson from "$1" --argjson fresh "$2" '
    [inputs | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) | split(".") | map(tonumber)]
    | group_by(.[:2]) | length as $lines | to_entries[]
    | (.key >= $lines - $fresh) as $live | .value | sort | to_entries as $patches | $patches[]
    | (.key == ($patches | length) - 1) as $newest | select($newest or .value[1] >= $from)
    | [(.value | map(tostring) | join(".")), ($newest and $live)] | @tsv'
}

# The pinned row starting with $1, unless $2 asks for a refresh.
kept() {
  [ "$2" = false ] && grep -m 1 -F "$1" providers/pins.ml
}

# Wraps the rows on stdin in a named list.
table() {
  echo "let $1 ="
  echo "  ["
  cat
  echo "  ]"
  echo
}

# Prints a toolchain record for repository $1, version $2, and builder and
# runtime tag suffixes $3 and $4.
toolchain() {
  local builder runtime
  builder=$(image "$1" "$2$3") || return
  runtime=$(image "$1" "$2$4") || return
  printf '{ release = "%s"; builder = "%s"; runtime = "%s" }' "$2" "$builder" "$runtime"
}

image_rows() {
  local version pinned
  registry "$1" tags/list | jq -r '.tags[]' | newest_minors "$2" | while read -r version; do
    if pinned=$(image "$1" "$version"); then
      echo "    { version = \"$version\"; image = \"$pinned\" };"
    else
      [ $? = 2 ] || exit 1
    fi
  done
}

# Go 1.21 added exact toolchains to go.mod; an older module selects the newest
# patch of its minor.
go_rows() {
  local version refresh row pinned
  registry library/golang tags/list | jq -r '.tags[]' | patches 21 3 | while IFS=$'\t' read -r version refresh; do
    if row=$(kept "    { version = \"$version\"; image = \"docker.io/library/golang@" "$refresh"); then
      echo "$row"
    elif pinned=$(image library/golang "$version"); then
      echo "    { version = \"$version\"; image = \"$pinned\" };"
    else
      [ $? = 2 ] || exit 1
    fi
  done
}

# The newest stable release of each of the three newest majors, oldest first.
manager_rows() {
  fetch -H 'Accept: application/vnd.npm.install-v1+json' "https://registry.npmjs.org/$1" | jq -r '
    [.versions | to_entries[]
     | select((.key | test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) and (.value.deprecated == null))
     | {parts: (.key | split(".") | map(tonumber)), key, engines: (.value.engines.node? // "*")}]
    | group_by(.parts[0]) | map(max_by(.parts)) | .[-3:][]
    | "    { tool = \"\(.key)\"; engines = \"\(.engines)\" };"'
}

# Every release with images in each Node major inside its support window today,
# oldest first, refreshing the newest of each.
node_rows() {
  local version npm lts refresh row
  fetch https://raw.githubusercontent.com/nodejs/Release/main/schedule.json > "$stage/schedule"
  registry library/node tags/list | jq '[.tags[] | {(.): true}] | add' > "$stage/tags"
  fetch https://nodejs.org/dist/index.json | jq -r --arg today "$(date -u +%F)" \
    --slurpfile schedule "$stage/schedule" --slurpfile tags "$stage/tags" '
    ($schedule[0] | to_entries | map(select(.value.start <= $today and $today < .value.end) | .key)) as $majors
    | [.[] | (.version | ltrimstr("v")) as $v
       | select((.version | split(".")[0] | IN($majors[])) and $tags[0][$v + "-bookworm"] and $tags[0][$v + "-bookworm-slim"])
       | . + {v: $v, parts: ($v | split(".") | map(tonumber))}]
    | group_by(.parts[0])[] | sort_by(.parts) | to_entries as $releases | $releases[]
    | (.key == ($releases | length) - 1) as $refresh | .value
    | [.v, .npm, (.lts | if . then "Some \"\(ascii_downcase)\"" else "None" end), $refresh] | @tsv' |
    while IFS=$'\t' read -r version npm lts refresh; do
      if row=$(kept "    { node = { release = \"$version\";" "$refresh"); then
        echo "$row"
      elif row=$(toolchain library/node "$version" -bookworm -bookworm-slim); then
        echo "    { node = $row; npm = \"$npm\"; lts = $lts };"
      else
        [ $? = 2 ] || exit 1
      fi
    done
}

# Every stable release, oldest first, so an exact declaration always finds its
# pin. Only the newest patch of each supported minor is refreshed; an older one
# keeps its digest, so it costs no requests once pinned.
python_rows() {
  local version refresh row
  registry library/python tags/list | jq -r '.tags[]' | sed -n 's/-trixie$//p' | patches 0 5 |
    while IFS=$'\t' read -r version refresh; do
      if row=$(kept "    { release = \"$version\";" "$refresh"); then
        echo "$row"
      elif row=$(toolchain library/python "$version" -trixie -slim-trixie); then
        echo "    $row;"
      else
        [ $? = 2 ] || exit 1
      fi
    done
}

{
  echo '(* Generated by scripts/bump-pins. Do not edit. *)'
  echo
  sed -n '/^type/,/^$/p' providers/pins.mli
  node_rows | table node
  manager_rows npm | table npm
  manager_rows pnpm | table pnpm
  python_rows | table python
  image_rows astral/uv 3 | table uv
  image_rows oven/bun 3 | table bun
  image_rows denoland/deno 3 | table deno
  go_rows | table golang
  debian=$(image library/debian bookworm-slim)
  echo "let debian = \"$debian\""
} > "$stage/pins.ml"
mv "$stage/pins.ml" providers/pins.ml
