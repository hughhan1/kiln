opam-version: "2.0"
name: "kiln_ocaml"
version: "0.0.1"
synopsis: "Modular application build planner"
maintainer: "Hugh Han"
authors: "Hugh Han"
license: "MIT"
homepage: "https://github.com/hughhan1/kiln"
bug-reports: "https://github.com/hughhan1/kiln/issues"
depends: [
  "angstrom" {= "0.16.1"}
  "astring" {= "0.8.5"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "bigstringaf" {= "0.10.0"}
  "bos" {= "0.3.0"}
  "cmdliner" {= "2.1.1"}
  "conf-libcurl" {= "2"}
  "csexp" {= "1.5.2"}
  "ctypes" {= "0.24.0"}
  "digestif" {= "1.3.0"}
  "dune" {= "3.24.2"}
  "dune-configurator" {= "3.24.2"}
  "eqaf" {= "0.10"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "integers" {= "0.8.0"}
  "logs" {= "0.10.0"}
  "menhir" {= "20250912"}
  "menhirCST" {= "20250912"}
  "menhirLib" {= "20250912"}
  "menhirSdk" {= "20250912"}
  "ocaml" {= "5.5.1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ocurl" {= "0.9.2"}
  "otoml" {= "1.0.5"}
  "rresult" {= "0.7.0"}
  "stdlib-shims" {= "0.3.0"}
  "topkg" {= "1.1.1"}
  "uutf" {= "1.0.4"}
  "yaml" {= "3.2.0"}
  "yojson" {= "3.0.0"}
]
build: ["dune" "build" "-p" name "-j" jobs]
