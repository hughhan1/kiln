opam-version: "2.0"
name: "kiln_ocaml"
version: "0.0.1"
synopsis: "Modular application build planner"
maintainer: "Hugh Han"
authors: ["Hugh Han"]
license: "MIT"
homepage: "https://github.com/hughhan1/kiln"
bug-reports: "https://github.com/hughhan1/kiln/issues"
build: [["dune" "build" "-p" name "-j" jobs]]
depends: [
  "cmdliner" {= "2.1.1"}
  "ocaml" {= "5.5.1"}
  "dune" {>= "3.18"}
  "yojson" {= "3.0.0"}
  "angstrom" {= "0.16.1"}
  "digestif" {= "1.3.0"}
  "otoml" {= "1.0.5"}
  "yaml" {= "3.2.0"}
  "ocurl" {= "0.9.2"}
]
